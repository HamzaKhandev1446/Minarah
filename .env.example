# Copy to .env.local. Never put a secret/service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only search configuration (metres, maximum 50000).
NEARBY_RADIUS_METERS=5000

# Optional compatible OpenStreetMap raster tile endpoint. No offline tile prefetch.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional authenticated acceptance tests: dedicated staging project only.
# These tests create a clearly labelled test mosque, claim and publications.
# Use different confirmed accounts; the platform account needs platform_admins access.
MINARAH_E2E_STAGING=0
MINARAH_E2E_BASE_URL=
MINARAH_E2E_MEMBER_EMAIL=
MINARAH_E2E_MEMBER_PASSWORD=
MINARAH_E2E_PLATFORM_EMAIL=
MINARAH_E2E_PLATFORM_PASSWORD=
# Optional Photon-compatible place-search endpoint (explicit searches only).
NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
